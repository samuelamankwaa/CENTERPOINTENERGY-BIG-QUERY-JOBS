WITH ranked_events AS (
  SELECT
    ef.EVENTNAME,
    ef.STARTDATETIME,
    ef.RESTOREDDATETIME,
    ss.CREW_COMPLETION_DATE,
    ef.TROUBLE_LVL,
    ef.SERVICECENTER,
    ef.NUMCUSTDEENERGIZED AS CUSTOMERS_AFFECTED,
    cf.NO_CALLS AS NUM_OF_CALLS,
    ss.TRANSFORMER1_RMV_NUM,
    ss.TRANSFORMER2_RMV_NUM,
    ss.TRANSFORMER3_RMV_NUM,
    ARRAY_TO_STRING(ARRAY_AGG(action_taken) OVER (PARTITION BY ss.EVENTNAME), ' . ') AS Action_Taken,
    ss.CREW_NOTES AS COMMENTS,    
    ef.DEVICENAME,    
    ef.DURATIONHM,
    ROW_NUMBER() OVER (
      PARTITION BY ef.EVENTNAME
      ORDER BY ss.ACTION_TAKEN_1 DESC, cf.NO_CALLS DESC
    ) AS row_num,
    -- Total transformers for this row/event (numeric sum of the values)
    COALESCE(SAFE_CAST(ss.TRANSFORMER1_RMV_NUM AS INT64), 0) 
    + COALESCE(SAFE_CAST(ss.TRANSFORMER2_RMV_NUM AS INT64), 0) 
    + COALESCE(SAFE_CAST(ss.TRANSFORMER3_RMV_NUM AS INT64), 0) AS TOTAL_XFMERS,
    
    -- Per-event count of non-null transformer columns (0 to 3)
    (CASE WHEN ss.TRANSFORMER1_RMV_NUM IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN ss.TRANSFORMER2_RMV_NUM IS NOT NULL THEN 1 ELSE 0 END) +
    (CASE WHEN ss.TRANSFORMER3_RMV_NUM IS NOT NULL THEN 1 ELSE 0 END) AS TRANSFORMER_COUNT
  FROM `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_SERVICE_SUITE` ss  
  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_EVENT_FACT` ef
    ON ef.EVENTNAME = ss.EVENTNAME
  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_CALL_FACT` cf
    ON cf.EVENTKEY = ef.EVENTKEY
  CROSS JOIN UNNEST([ss.ACTION_TAKEN_1, ss.ACTION_TAKEN_2, ss.ACTION_TAKEN_3,
                     ss.ACTION_TAKEN_4, ss.ACTION_TAKEN_5, ss.ACTION_TAKEN_6]) AS action_taken
  WHERE TIMESTAMP(ef.STARTDATETIME) BETWEEN TIMESTAMP("2021-01-01 00:00:00") 
    AND TIMESTAMP("2024-04-30 23:59:59")
    --AND (ss.CREW_NOTES LIKE '%rotten%' OR ss.CREW_NOTES LIKE '%Rotten%' OR ss.CREW_NOTES LIKE '%ROTTEN%' OR CREW_NOTES LIKE '%rott%' OR ss.CREW_NOTES    LIKE '%Rott%')
    AND ef.RESTOREDDATETIME IS NOT NULL
    AND ef.EXCLUDETROUBLEFLAG = 0
    AND ef.MOMENTARYOUTAGEFLAG = 0
    AND ef.CANCELLEDFLAG = 0
    AND ef.TROUBLE_LVL IS NOT NULL
    AND ef.PLANNEDOTGFLAG = 0
    AND ef.NONOUTGCALLFLAG = 0
    AND ef.ORPHANOUTAGEFLAG = 0
    AND Action_Taken LIKE '%Rpld BU Trans%'
    AND ef.SERVICECENTER NOT IN ('BV', 'EV', 'FB', 'MV', 'RP', 'INDIANA')
  ORDER BY ef.STARTDATETIME
)
SELECT 
  * EXCEPT(row_num),
  -- Daily total transformers replaced (sum of the numeric values)
  SUM(TOTAL_XFMERS) OVER (PARTITION BY DATE(STARTDATETIME)) AS TOTAL_XFMERS_PER_DAY,
  
  -- Daily count of individual non-null transformer slots (max 3 per event)
  SUM(TRANSFORMER_COUNT) OVER (PARTITION BY DATE(STARTDATETIME)) AS TOTAL_TRANSFORMAER
FROM ranked_events
WHERE row_num = 1
ORDER BY STARTDATETIME;
