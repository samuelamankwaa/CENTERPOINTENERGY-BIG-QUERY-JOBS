call_facts AS (
  SELECT
    EVENTKEY,
    'AMS' AS CALLERTYPE,
    COUNT(*) AS numofcalls,
    STRING_AGG(
      DISTINCT CALLDESC,
      ' | '
      ORDER BY CALLDESC
    ) AS hazard_type
  FROM `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_CALL_FACT`
  WHERE CALLERTYPE = 'AMS'
  GROUP BY EVENTKEY
),

actions_taken AS (
  SELECT
    eventname,
    STRING_AGG(
      DISTINCT action_taken_name,
      " | "
      ORDER BY action_taken_name
    ) AS action_taken
  FROM `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_ALL_ACTIONS_TAKEN`
  GROUP BY eventname
),

service_suite AS (
  SELECT
    EVENTNAME,
    REFERRED,
    REFERRED_DATE,
    REFERRED_REASON,
    REFERRED_REASON_NOTES as REFERRED_REMARKS,
    ANY_VALUE(REFERRED) AS referrals_needed,
    STRING_AGG(
      DISTINCT CREW_NOTES,
      " | "
      ORDER BY CREW_NOTES
    ) AS crew_notes
  FROM `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_SERVICE_SUITE`
  WHERE  REFERRED = 'Y'
  GROUP BY EVENTNAME, REFERRED,
    REFERRED_DATE,
    REFERRED_REASON,
    REFERRED_REMARKS
),
order_hist AS (SELECT
  HOST_ORDER_NUMBER,
  PROCESS_ID AS EVENTNAME,
  LAST_CHANGE_DTTM,
  CREATION_DATE,
  CREATION_TIME,
  DATETIME(CREATION_DATE, PARSE_TIME('%H:%M:%S', CREATION_TIME)) AS CREATION_DATETIME,
  DISPATCH_DATE,
  DISPATCH_TIME,
  DATETIME(DISPATCH_DATE, PARSE_TIME('%H:%M:%S', DISPATCH_TIME)) AS DISPATCH_DATETIME,
  ENROUTE_DATE,
  ENROUTE_TIME,
  DATETIME(ENROUTE_DATE, PARSE_TIME('%H:%M:%S', ENROUTE_TIME)) AS ENROUTE_DATETIME,
  ONSITE_DATE,
  ONSITE_TIME,
  DATETIME(ONSITE_DATE, PARSE_TIME('%H:%M:%S', ONSITE_TIME)) AS ONSITE_DATETIME,
  MIN(DATETIME(ONSITE_DATE, PARSE_TIME('%H:%M:%S', ONSITE_TIME))) 
    OVER (PARTITION BY HOST_ORDER_NUMBER) AS FIRST_CREW_ONSITE_TIME,
  MAX(DATETIME(ONSITE_DATE, PARSE_TIME('%H:%M:%S', ONSITE_TIME))) 
    OVER (PARTITION BY HOST_ORDER_NUMBER) AS LAST_CREW_ONSITE_TIME,
  COMPLETE_DATE,
  COMPLETE_TIME,
  JOB_CODE_DESCRIPTION,
  ESIID,
  TECHNICIAN_ID,
  TECHNICIAN_NAME,
  CMPL_STATUS AS COMPLETION_STATUS,
  LAST_STATUS
FROM `cnp-datafoundation-prod.ELECTRIC_OPS.T_STG_MBL_TECH_ROUTE_HIST`
WHERE LAST_CHANGE_DTTM >= DATETIME("2026-09-11 00:00:00")
  AND LAST_CHANGE_DTTM <= DATETIME("2026-09-18 00:00:00")
QUALIFY ROW_NUMBER() OVER (PARTITION BY PROCESS_ID ORDER BY LAST_CHANGE_DTTM DESC) = 1
ORDER BY LAST_CHANGE_DTTM DESC),

event_fact AS (
  SELECT
    EVENTNAME,
    ANY_VALUE(STARTDATETIME) AS startdatetime,
    ANY_VALUE(RESTOREDDATETIME) AS restoreddatetime,
    ANY_VALUE(TROUBLE_LVL) AS trouble_lvl,
    ANY_VALUE(EVENTPRIORITYNUM) AS hazard_level,
    ANY_VALUE(EVENTKEY) AS eventkey,
    ANY_VALUE(NUMCALLS) AS numofcalls,
    ANY_VALUE(NUMCUSTDEENERGIZED) AS numcustaffected
  FROM `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_EVENT_FACT`
  WHERE STARTDATETIME >= DATETIME("2026-09-11 00:00:00")
    AND STARTDATETIME <= DATETIME("2026-09-18 00:00:00")
    AND EXCLUDETROUBLEFLAG = 0
    AND MOMENTARYOUTAGEFLAG = 0
    AND CANCELLEDFLAG = 0
    AND PLANNEDOTGFLAG = 0
    AND NONOUTGCALLFLAG = 0
    AND ORPHANOUTAGEFLAG = 0
    AND TROUBLE_LVL IS NOT NULL
    AND EVENTPRIORITYNUM IS NOT NULL
    AND EVENTPRIORITYNUM != 0
    AND SERVICECENTER NOT IN ("BV", "EV", "FB", "MV", "RP", "INDIANA")
  GROUP BY EVENTNAME
)

SELECT
  ef.EVENTNAME,
  ef.startdatetime AS STARTDATETIME,
  ef.restoreddatetime AS RESTOREDDATETIME,
  cf.CALLERTYPE,
  ef.trouble_lvl AS TROUBLE_LVL,
  oh.CREATION_DATETIME,
  act.action_taken AS ACTION_TAKEN,
  oh.ONSITE_DATETIME,
  oh.FIRST_CREW_ONSITE_TIME,
  oh.LAST_CREW_ONSITE_TIME,
  ss.REFERRED,
  ss.REFERRED_DATE,
  ss.REFERRED_REASON,
  ss.REFERRED_REMARKS,
  cf.numofcalls AS NUMBEROFCALLS,
  ef.numcustaffected AS NUMCUSTAFFECTED,
  oh.TECHNICIAN_ID AS CREW_ID,
  oh.TECHNICIAN_NAME AS CREW_NAME,
  ss.crew_notes AS CREW_NOTES,
  oh.COMPLETION_STATUS,
  oh.LAST_STATUS
FROM event_fact AS ef
INNER JOIN service_suite AS ss
  ON ss.EVENTNAME = ef.EVENTNAME
LEFT JOIN order_tasks AS ot
  ON ot.OrderNumber = ef.EVENTNAME
INNER JOIN call_facts AS cf
  ON cf.EVENTKEY = ef.eventkey
LEFT JOIN actions_taken AS act
  ON act.eventname = ef.EVENTNAME
LEFT JOIN order_hist AS oh
  ON oh.EVENTNAME = ef.EVENTNAME
ORDER BY
  STARTDATETIME,
  RESTOREDDATETIME,
  HAZARD_TYPE;

