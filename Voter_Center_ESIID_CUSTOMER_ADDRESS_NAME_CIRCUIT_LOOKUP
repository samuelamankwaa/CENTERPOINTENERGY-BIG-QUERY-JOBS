WITH ranked_events AS (
  SELECT DISTINCT
    cn.CUSTNAME AS CUSTOMER_NAME,
    cn.CUSTADDRESS as ADDRESS,
    ef.STARTDATETIME,
    cn.CUSTCODE AS ESIID,
    ef.FEEDERNAME AS CIRCUIT_NAME,

    ROW_NUMBER() OVER (
      PARTITION BY ef.EVENTNAME
      ORDER BY
        ss.ACTION_TAKEN_1 DESC,
        cf.NO_CALLS DESC
    ) AS row_num

  FROM `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_EVENT_FACT` ef

  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_RESTORATION_FACT`  rf
   ON rf.DEENEVENTKEY  = ef.EVENTKEY

  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_SERVICE_SUITE` ss
    ON ef.EVENTNAME = ss.EVENTNAME

  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_CALL_FACT` cf
    ON cf.EVENTKEY = ef.EVENTKEY

  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_CUSTAFFECTED_INT` ct
    ON ct.RESTFACTKEY = rf.RESTFACTKEY

  LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_CPY_CUSTOMER_DIM` cn
    ON cn.CUSTKEY = ct.CUSTKEY

  LEFT JOIN `smart-meter-production.SMF.PREMISE_CHAR` sm 
    ON cn.CUSTCODE = sm.ESIID


