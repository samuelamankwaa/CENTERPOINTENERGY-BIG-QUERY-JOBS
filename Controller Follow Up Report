     h.MAIFI_SA

 FROM `cnp-datafoundation-prod.TECHOPS_RELIABILITY_REPORTING_TABLES.RRD_TB_CIRCUITOUTAGEHISTORY` h
LEFT JOIN `cnp-datafoundation-prod.TECHOPS_FOCALPOINT_VIEWS.V_OMS_SERVICE_SUITE` ss
  ON ss.eventname = h.eventname
WHERE h.OUTDATETIME >= DATETIME(
  DATE_SUB(CURRENT_DATE('America/Chicago'), INTERVAL 7 DAY)
)
AND h.PRIMARY_CASE = 'Y'
ORDER BY h.OUTDATETIME
